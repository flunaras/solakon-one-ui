# Build image for openSUSE Tumbleweed — Qt6, no KDE Frameworks
FROM opensuse/tumbleweed:latest

LABEL org.opencontainers.image.title="solakon-one-ui-builder-tumbleweed"
LABEL org.opencontainers.image.description="Build environment for solakon-one-ui on openSUSE Tumbleweed (Qt6)"

# ── Sync base image against current repo metadata ─────────────────────────────
# The published opensuse/tumbleweed:latest image snapshot frequently lags
# behind the repo metadata pulled at build time (rolling release). This can
# leave some already-installed packages (e.g. libmount1) at a version that
# conflicts with newer packages' requirements (e.g. qt6-base-devel requiring
# a Qt6Gui built against a newer libmount1), causing "not installable
# providers" errors. Running a full `zypper dup` first brings every base
# package up to the same snapshot as the repo metadata so later installs
# resolve cleanly.
RUN zypper --non-interactive refresh && \
    zypper --non-interactive dup --no-allow-vendor-change

# ── Base build tools ───────────────────────────────────────────────────────────
RUN zypper --non-interactive install --no-recommends \
        cmake \
        ninja \
        gcc-c++ \
        make \
        git \
        pkg-config \
        gzip \
        tar \
        which

# ── Remove busybox-gawk — conflicts with qt6-printsupport-devel (Qt 6.11+) ────
RUN zypper --non-interactive remove busybox-gawk && \
    zypper --non-interactive install --no-recommends gawk

# ── Qt6 development libraries ─────────────────────────────────────────────────
RUN zypper --non-interactive install --no-recommends \
        qt6-base-devel \
        qt6-base-private-devel \
        qt6-serialbus-devel \
        qt6-charts-devel \
        qt6-tools-devel \
        qt6-test-devel

# ── RPM packaging tools ────────────────────────────────────────────────────────
RUN zypper --non-interactive install --no-recommends \
        rpm-build

RUN mkdir -p /build && chmod 777 /build

WORKDIR /src
